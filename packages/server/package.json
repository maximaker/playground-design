{
  "name": "@playground/server",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --experimental-strip-types --experimental-sqlite --watch src/index.ts",
    "start": "node --experimental-strip-types --experimental-sqlite src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/strip-check.mjs && node --experimental-strip-types --experimental-sqlite --test --test-timeout=60000 src/mcp.test.ts src/fidelity.test.ts src/persistence.test.ts src/connect.test.ts src/security.test.ts src/image-import.test.ts src/live.test.ts src/import-css.test.ts",
    "cli": "node --experimental-strip-types --experimental-sqlite src/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@playground/shared": "*",
    "@vercel/blob": "^2.8.2",
    "hono": "^4.13.13",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "playwright": "^1.64.1",
    "typescript": "^5.7.2"
  }
}
