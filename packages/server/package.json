{
  "name": "@playground/server",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --experimental-strip-types --experimental-sqlite --watch src/index.ts",
    "start": "node --experimental-strip-types --experimental-sqlite src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/strip-check.mjs && node --experimental-strip-types --experimental-sqlite --test --test-timeout=60000 src/mcp.test.ts src/fidelity.test.ts src/persistence.test.ts src/connect.test.ts src/security.test.ts",
    "cli": "node --experimental-strip-types --experimental-sqlite src/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@playground/shared": "*",
    "@vercel/blob": "^2.8.0",
    "hono": "^4.6.14",
    "ws": "^8.18.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.5.13",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
